{
  "name": "flashpeek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CS2 player stats and live game companion — flashpeek.gg",
  "scripts": {
    "dev": "vite --port 5174",
    "server": "tsx server/main.ts",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "boundaries": "node scripts/check-boundaries.mjs",
    "anti-ai-ui": "node scripts/check-anti-ai-ui.mjs",
    "control": "node .cursor/skills/verify-flashpeek/control-flashpeek.mjs",
    "verify:smoke": "node scripts/ci-drive-smoke.mjs",
    "ci:drive": "node scripts/ci-drive-smoke.mjs",
    "visual-parity": "node scripts/check-visual-parity.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "oxlint": "^0.16.10",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
